# GEMINI_API_KEY: Required for optional Gemini AI API features (Culinary forecasts, chat assistant).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL / PostgreSQL Database credentials
SQL_HOST="127.0.0.1"
SQL_USER="canteen_user"
SQL_PASSWORD="YOUR_SECURE_DATABASE_PASSWORD_HERE"
SQL_DB_NAME="smart_canteen"
DATABASE_URL="postgresql://canteen_user:YOUR_SECURE_DATABASE_PASSWORD_HERE@127.0.0.1:5432/smart_canteen"

# Master Canteen Verification Passkey (Required for official canteen registration/transfer)
CANTEEN_MASTER_PASSCODE="YOUR_STRONG_MASTER_PASSCODE_HERE"

# CORS Configuration: Comma-separated list of allowed origins (Web & Mobile)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,http://10.0.2.2:3000,http://10.0.2.2:8081"

# Client-side API Base URL (Leave empty for relative paths on web, or set to server URL for mobile/cross-origin)
VITE_API_BASE_URL=""
EXPO_PUBLIC_API_BASE_URL="http://10.0.2.2:3000"

# Server-Side Authorized Accounts (BACKEND ONLY - NEVER EXPOSE TO CLIENT)
ADMIN_EMAILS="admin@college.edu"
STAFF_EMAILS="chef@college.edu,canteen@college.edu"
